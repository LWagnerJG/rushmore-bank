# Local PartyKit (override; required for test/preview builds)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# App environment: development | preview | test | production
# When test/preview, NEXT_PUBLIC_PARTYKIT_HOST must be set to a non-production host
# or rooms refuse to connect (no silent fallback to production PartyKit).
# NEXT_PUBLIC_APP_ENV=development

# Server-only — never expose in the browser bundle
# Preferred AI judge (gemini-3.5-flash). Either name works:
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional fallback if Gemini unset:
# OPENAI_API_KEY=
# Shared secret so only PartyKit can call /api/judge for paid scoring (required when a paid key is set)
# JUDGE_SECRET=
# Optional absolute app URL for PartyKit → Next judge calls
# JUDGE_URL=https://roundacats.vercel.app
