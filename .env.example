# Local PartyKit (override the production default)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# When unset, the app uses: rushmore-bank.lwagnerjg.partykit.dev

# Server-only — never expose in the browser bundle
# Preferred AI judge (Gemini 2.0 Flash). Either name works:
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional fallback if Gemini unset:
# OPENAI_API_KEY=
# Shared secret so only PartyKit can call /api/judge for paid scoring
# JUDGE_SECRET=
# Optional absolute app URL for PartyKit → Next judge calls
# JUDGE_URL=https://roundacats.vercel.app
