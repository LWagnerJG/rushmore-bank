# Local PartyKit (override the production default)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Development defaults to localhost:1999; production retains the original host.
# Preview/test builds require their own NEXT_PUBLIC_PARTYKIT_HOST.
# Set NEXT_PUBLIC_APP_ENV=test for a separate Vercel test project.

# Server-only — never expose in the browser bundle
# Preferred AI judge. Either key name works:
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Optional fallback if Gemini unset:
# OPENAI_API_KEY=
# Required for paid scoring: the same secret on Vercel and PartyKit
# JUDGE_SECRET=
# Optional absolute app URL for PartyKit → Next judge calls
# JUDGE_URL=https://roundacats.vercel.app

