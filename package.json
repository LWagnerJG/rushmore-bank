{
  "name": "quarry",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"wrangler dev\" \"next dev --turbopack\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ios-keyboard": "tsx scripts/verify-ios-keyboard.ts",
    "test:watch": "vitest",
    "smoke:three": "tsx scripts/smoke-three.ts",
    "smoke:bots": "tsx scripts/smoke-bots.ts",
    "smoke:judge": "node scripts/judge-smoke.mjs",
    "health:party": "tsx scripts/server-health.ts",
    "dev:next": "next dev --turbopack",
    "dev:party": "wrangler dev",
    "deploy:party": "wrangler deploy --config wrangler.jsonc",
    "build:web": "opennextjs-cloudflare build --config wrangler.web.jsonc",
    "preview:web": "opennextjs-cloudflare build --config wrangler.web.jsonc && opennextjs-cloudflare preview --config wrangler.web.jsonc",
    "deploy:web": "opennextjs-cloudflare build --config wrangler.web.jsonc && opennextjs-cloudflare deploy --config wrangler.web.jsonc -- --keep-vars",
    "cf-typegen": "wrangler types --config wrangler.web.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify:dice": "tsx scripts/verify-dice-settle.ts",
    "verify:web": "tsx scripts/verify-beans-web.ts",
    "verify:install": "tsx scripts/verify-install-join.ts",
    "test:playtest": "tsx scripts/verify-playtest-robustness.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "next": "^16.3.8",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  }
}
