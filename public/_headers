# Cloudflare Workers Static Assets — match Next.js immutable caching for build output.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# PWA shell + service worker must revalidate so installs pick up new deploys.
/sw.js
  Cache-Control: public,max-age=0,must-revalidate
  Service-Worker-Allowed: /

/site.webmanifest
  Cache-Control: public,max-age=0,must-revalidate
