/**
 * PartyServer (Cloudflare Workers + Durable Objects) config for Beans.
 *
 * Deploy: npx wrangler deploy
 * Local:  npx wrangler dev  (default http://127.0.0.1:8787)
 *
 * Set the workers.dev host as NEXT_PUBLIC_PARTYKIT_HOST on Vercel (env name is
 * historical). Put JUDGE_SECRET with: npx wrangler secret put JUDGE_SECRET
 */
{
  "name": "beans-party",
  "main": "party/server.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "QuarryServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuarryServer"] }],
  "vars": {
    "JUDGE_URL": "https://beans-game.vercel.app"
  }
}
