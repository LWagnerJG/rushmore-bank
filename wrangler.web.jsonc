/**
 * OpenNext / Cloudflare Workers config for the Beans Next.js frontend.
 *
 * Separate from wrangler.jsonc (PartyServer `beans-party`).
 *
 * Deploy: npm run deploy:web
 * Local preview: npm run preview:web
 *
 * Secrets (set via GitHub Actions or CLI):
 *   npx wrangler secret put GEMINI_API_KEY --config wrangler.web.jsonc
 *   npx wrangler secret put GOOGLE_GENERATIVE_AI_API_KEY --config wrangler.web.jsonc
 *   npx wrangler secret put GROQ_API_KEY --config wrangler.web.jsonc
 *   npx wrangler secret put JUDGE_SECRET --config wrangler.web.jsonc
 *
 * NEXT_PUBLIC_* vars are also injected at build time in CI so they are inlined
 * into the client bundle; runtime vars below cover SSR / Route Handlers.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beans-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "beans-web"
    }
  ],
  // Note: do not set limits.cpu_ms — Free plan rejects it (API 100328).
  // Judge wall-clock budget is enforced in route.ts (REQUEST_BUDGET_MS).
  "vars": {
    "NEXT_PUBLIC_PARTYKIT_HOST": "beans-party.beans-lwagner.workers.dev",
    "BEANS_PLATFORM": "Cloudflare",
    // Pre-game GET + authorized POST /api/judge proxy here when this Worker
    // has no Gemini/Groq keys. PartyServer posts to beans-web; beans-web
    // forwards to Vercel where the keys live.
    "JUDGE_URL": "https://beans-game.vercel.app"
  },
  "observability": {
    "enabled": true
  }
}
